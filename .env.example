# === めにゅらく！ 環境変数テンプレート ===
# このファイルをコピーして .env を作成し、実際の値を入れてください（.env はコミットされません）。
# 本番はホスティングの環境変数に同じキーを設定します。

# --- 必須: Claude API キー ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 必須: Postgres 接続文字列（Neon / Supabase） ---
# Neon のダッシュボードの Connection string をそのまま貼り付け
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- 任意: サーバー ---
# PORT=3000

# --- フェーズ2: セッション・レート制限（任意） ---
# SESSION_TTL_DAYS=30            # ログインセッションの有効期限（日）。既定30
# AI_RATE_LIMIT_PER_HOUR=40     # 1ユーザーあたりのAI生成回数/時 の上限。既定40

# --- フェーズ3: Stripe 課金（フリーミアム） ---
# STRIPE_SECRET_KEY と STRIPE_PRICE_ID の両方がそろうと課金が有効化されます。
# 未設定の間は AI 生成が全ユーザーに開放されます（公開前でも普通に使えます）。
# STRIPE_SECRET_KEY=sk_test_xxx       # Stripe ダッシュボード（テストモード）の Secret key
# STRIPE_PRICE_ID=price_xxx           # 月額サブスクの Price ID（`npm run stripe:setup` で作成・表示可）
# STRIPE_WEBHOOK_SECRET=whsec_xxx     # `stripe listen` またはダッシュボードのWebhookで発行される署名シークレット
# APP_BASE_URL=http://localhost:3000  # Checkout の成功/キャンセル戻り先。本番は公開URL
# FREE_AI_PER_MONTH=3                 # 無料ユーザーの月間AI生成回数。既定3
