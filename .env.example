# === めにゅらく！ 環境変数テンプレート ===
# このファイルをコピーして .env を作成し、実際の値を入れてください（.env はコミットされません）。
# 本番はホスティングの環境変数に同じキーを設定します。

# --- 必須: Claude API キー ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 必須: Postgres 接続文字列（Neon / Supabase） ---
# Neon のダッシュボードの Connection string をそのまま貼り付け
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- 任意: サーバー ---
# PORT=3000

# === 以下はフェーズ2以降で使用（今は未設定でOK） ===

# --- フェーズ2: セッション ---
# SESSION_TTL_DAYS=30

# --- フェーズ3: Stripe 課金（Web） ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID=price_xxx
# APP_BASE_URL=http://localhost:3000
