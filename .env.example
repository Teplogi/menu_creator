# === めにゅらく！ 環境変数テンプレート ===
# このファイルをコピーして .env を作成し、実際の値を入れてください（.env はコミットされません）。
# 本番はホスティングの環境変数に同じキーを設定します。

# --- 必須: Claude API キー ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 任意: サーバー ---
# PORT=3000
# ローカルSQLiteのファイルパス（既定 data.db）
# DB_PATH=data.db

# === 以下はフェーズ1以降で使用（今は未設定でOK） ===
# --- フェーズ1: Postgres 移行 ---
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- フェーズ2: セッション ---
# SESSION_TTL_DAYS=30

# --- フェーズ3: Stripe 課金（Web） ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID=price_xxx
# APP_BASE_URL=http://localhost:3000
