{
  "name": "recipe-creator",
  "version": "1.0.0",
  "description": "期間を指定するとAIが毎日の献立を作成してくれるWebアプリ",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-pg.js",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "catalog:view": "node scripts/build-catalog-view.mjs",
    "catalog:check": "node scripts/check-catalog.mjs",
    "catalog:fix": "node scripts/check-catalog.mjs --fix",
    "catalog:enrich": "node scripts/enrich-catalog.mjs",
    "columns": "node scripts/build-columns.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7"
  }
}
