# === めにゅらく！ 環境変数テンプレート ===
# このファイルをコピーして .env を作成し、実際の値を入れてください（.env はコミットされません）。
# 本番はホスティングの環境変数に同じキーを設定します。

# --- 必須: Claude API キー ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 必須: Postgres 接続文字列（Neon / Supabase） ---
# Neon のダッシュボードの Connection string をそのまま貼り付け
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- 任意: サーバー ---
# PORT=3000

# --- フェーズ2: セッション・レート制限（任意） ---
# SESSION_TTL_DAYS=30            # ログインセッションの有効期限（日）。既定30
# AI_RATE_LIMIT_PER_HOUR=40     # 1ユーザーあたりのAI生成回数/時 の上限。既定40

# --- フェーズ3: Stripe 課金（フリーミアム） ---
# STRIPE_SECRET_KEY と STRIPE_PRICE_ID の両方がそろうと課金が有効化されます。
# 未設定の間は AI 生成が全ユーザーに開放されます（公開前でも普通に使えます）。
# STRIPE_SECRET_KEY=sk_test_xxx       # Stripe ダッシュボード（テストモード）の Secret key
# STRIPE_PRICE_ID=price_xxx           # 月額サブスクの Price ID（`npm run stripe:setup` で作成・表示可）
# STRIPE_WEBHOOK_SECRET=whsec_xxx     # `stripe listen` またはダッシュボードのWebhookで発行される署名シークレット
# APP_BASE_URL=http://localhost:3000  # Checkout の成功/キャンセル戻り先。本番は公開URL
# FREE_AI_MEALS_PER_MONTH=20          # 無料ユーザーが月に生成できる「食数」。既定20（回数でなく食事の数で計上）
# FREE_AI_EDITS_PER_MONTH=10          # 無料ユーザーのAI修正の月の回数。既定10（食数とは別枠）
# TEST_MODE=1                         # テスト期間モード。課金導線を止めて全機能を無料開放（本番キー設定後に 0）

# --- Googleログイン（任意） ---
# 設定すると新規登録は Google のみになる（既存のパスワード利用者はそのままログイン可）。
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# PASSWORD_SIGNUP=1                   # 1 にすると Google 有効時もパスワードでの新規登録を開く

# --- プッシュ通知（任意） ---
# 3つそろったときだけ通知を有効化。鍵は `npx web-push generate-vapid-keys` で作成。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- 献立生成のモデル（任意） ---
# GEN_MODEL=claude-haiku-4-5          # まとめて一括生成するとき
# GEN_MODEL_SINGLE=claude-haiku-4-5   # 1食ずつの順次生成・作り直し・1品差し替え

# --- 集計ページ（任意） ---
# /admin.html を見られる Google アカウントのメール（カンマ区切り）。未設定なら誰も見られない。
# ADMIN_EMAILS=you@example.com
